# Choose: ollama (local), openrouter, gemini, or groq
APOORVA_PROVIDER=ollama
# For local Ollama: set APOORVA_PROVIDER=ollama (default model qwen3.5:4b)
# OLLAMA_MODEL=qwen3.5:4b
OPENROUTER_MODEL=replace-with-a-tool-capable-model-id
# Optional aliases; set a model for each provider you plan to use.
# GEMINI_MODEL=...
# GROQ_MODEL=qwen/qwen3.8-27b
# APOORVA_MODEL can serve as a shared fallback

# Set the key for the selected provider. Keep this file out of version control.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional Ollama endpoint override
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional
# APOORVA_MEMORY_PATH=memory/apoorva.sqlite3
# APOORVA_MAX_ITERATIONS=12


# Optional project directory exposed to bounded read/search/check tools.
# Defaults to the directory from which main.py is started.
# APOORVA_WORKSPACE=C:\\Users\\you\\Projects\\your-repo

# Local offline voice (no LLM provider usage for STT/TTS)
APOORVA_TTS_ENABLED=true
APOORVA_AUDIO_THREADS=2

# Concurrency & Multi-threading: number of parallel tasks to execute concurrently
JARVIS_WORKERS=4

# British Neural Voice settings
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_VOICE_RATE=+3%
JARVIS_VOICE_PITCH=+0Hz

